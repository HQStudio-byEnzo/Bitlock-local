# BitLock - Variables d'environnement
# Copiez ce fichier vers .env et modifiez les valeurs

# Session (requis) - Générez une clé aléatoire: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Base de données SQLite locale
DB_PATH=./data/bitlock.db

# URL locale de l'application
APP_URL=http://localhost:3000
